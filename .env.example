# ── Site ────────────────────────────────────────────────────────────────
# Canonical production URL (no trailing slash). Used for metadata, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://www.nexolvetech.com

# ── Analytics (optional) ────────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Loaded only after the visitor grants cookie consent.
NEXT_PUBLIC_GA_ID=

# Privacy-friendly alternative (e.g. Plausible domain). Optional.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
